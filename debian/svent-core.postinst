#!/bin/sh
set -e

regen() {
  if [ -x /usr/libexec/svent/gen-menu ]; then
    /usr/libexec/svent/gen-menu || echo "SventOS menu generation failed; run /usr/libexec/svent/gen-menu to retry." >&2
  fi
}

if [ "$1" = "configure" ]; then
  python3 /usr/libexec/svent/configure-shell
  for home in /root /home/*; do
    [ -d "$home" ] || continue
    owner=$(stat -c '%u:%g' "$home")
    if [ ! -e "$home/.zshrc" ]; then
      cp -a /etc/skel/.zshrc "$home/.zshrc"
      chown "$owner" "$home/.zshrc"
    elif ! grep -Fxq 'source /usr/share/svent/zsh/history.zsh' "$home/.zshrc"; then
      backup_directory="$home/.local/state/svent-core/zsh-before-0.4.5"
      mkdir -p "$backup_directory"
      [ -e "$backup_directory/zshrc" ] || cp -a "$home/.zshrc" "$backup_directory/zshrc"
      printf '\nsource /usr/share/svent/zsh/history.zsh\n' >> "$home/.zshrc"
      chown "$owner" "$backup_directory" "$backup_directory/zshrc"
    fi
  done
  mkdir -p /usr/share/svent/catalog.d
  if [ -d /run/systemd/system ] && [ "$(stat -c '%d:%i' /)" = "$(stat -Lc '%d:%i' /proc/1/root 2>/dev/null)" ]; then
    sysctl -p /usr/lib/sysctl.d/90-svent-ping.conf >/dev/null || echo 'SventOS ping configuration will be applied at the next boot.' >&2
  fi
  regen
fi

if [ "$1" = "triggered" ]; then
  regen
fi

#DEBHELPER#
