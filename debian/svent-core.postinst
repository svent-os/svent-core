#!/bin/sh
set -e

regen() {
  if [ -x /usr/libexec/svent/gen-menu ]; then
    /usr/libexec/svent/gen-menu || echo "SventOS menu generation failed; run /usr/libexec/svent/gen-menu to retry." >&2
  fi
}

if [ "$1" = "configure" ]; then
  for home in /root /home/*; do
    [ -d "$home" ] || continue
    [ ! -e "$home/.zshrc" ] || continue
    owner=$(stat -c '%u:%g' "$home")
    cp -a /etc/skel/.zshrc "$home/.zshrc"
    chown "$owner" "$home/.zshrc"
  done
  mkdir -p /usr/share/svent/catalog.d
  regen
fi

if [ "$1" = "triggered" ]; then
  regen
fi

#DEBHELPER#
